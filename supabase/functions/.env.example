# Copy to supabase/functions/.env for local runs, or push with `supabase secrets set --env-file`.
# Never commit the real file.

# From the Enable Banking control panel: the application ID and its RS256 private key (PEM).
EB_APPLICATION_ID=
EB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Random string shared with the `cron_secret` Vault secret, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Where the consent callback sends the browser afterwards. Defaults to budgetapp://settings.
# APP_REDIRECT_URL=budgetapp://settings
